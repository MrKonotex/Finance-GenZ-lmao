# ── Hyperliquid ───────────────────────────────────────────────────────────────
# Your Hyperliquid wallet address (0x...) — used for vault data and position history
HL_WALLET_ADDRESS=

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, paste the token here
TELEGRAM_BOT_TOKEN=
# Your Telegram chat ID (send a message to @userinfobot to find it)
TELEGRAM_CHAT_ID=

# ── API Keys ──────────────────────────────────────────────────────────────────
# CoinGecko API key (free tier available at coingecko.com)
COINGECKO_API_KEY=
# Coinglass API key (paid — required for liquidation heatmap, OI, L/S ratio)
COINGLASS_API_KEY=
# Glassnode API key (optional — for MVRV, SOPR on-chain BTC metrics)
GLASSNODE_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path (default: ./finance_genz.db in backend directory)
DATABASE_URL=sqlite:///./finance_genz.db
